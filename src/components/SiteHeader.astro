---
import MainNavigation from './MainNavigation.astro';
---

<header class="border-b border-site-faint">
	<div
		class="mx-auto flex min-h-18 w-full max-w-[var(--wide)] flex-col items-start gap-x-8 gap-y-4 px-4 py-3.5 min-[32rem]:flex-row min-[32rem]:items-center min-[32rem]:justify-between min-[32rem]:py-0 sm:px-6 xl:px-0"
	>
		<a
			class="text-base font-semibold tracking-[0.025em] text-site-text no-underline"
			href="/"
			aria-label="Floating-Gate.com ホーム">Floating-Gate.com</a
		>
		<MainNavigation />
	</div>
</header>

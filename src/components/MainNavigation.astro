---
import { NAV_ITEMS } from '../config';

const pathname = Astro.url.pathname;
---

<nav aria-label="メインナビゲーション">
	<ul class="m-0 flex list-none flex-wrap gap-x-4 gap-y-1 p-0">
		{
			NAV_ITEMS.map((item) => {
				const isCurrent = item.href === '/' ? pathname === '/' : pathname.startsWith(item.href);
				return (
					<li>
						<a
							class:list={[
								'py-1 text-sm text-site-muted no-underline hover:text-site-text',
								isCurrent &&
									'font-medium text-site-text underline decoration-2 decoration-site-accent underline-offset-[0.4rem]',
							]}
							href={item.href}
							aria-current={isCurrent ? 'page' : undefined}
						>
							{item.label}
						</a>
					</li>
				);
			})
		}
	</ul>
</nav>

---
import { SITE } from '../config';

const year = new Date().getFullYear();
---

<footer class="border-t border-site-faint text-[0.82rem] text-site-muted">
	<div
		class="mx-auto flex w-full max-w-[var(--wide)] flex-wrap justify-between gap-x-6 gap-y-1 px-4 py-7 sm:px-6 xl:px-0"
	>
		<p class="m-0">Copyright &copy; {year}  {SITE.author} - All rights reserved.</p>
		<p class="m-0"><a href="/rss.xml">RSS</a> · 作ったものと学んだことの記録</p>
	</div>
</footer>

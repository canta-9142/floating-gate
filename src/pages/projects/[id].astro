---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ExternalLink from '../../components/ExternalLink.astro';
import PostList from '../../components/PostList.astro';
import ProjectStatus from '../../components/ProjectStatus.astro';
import ProseLayout from '../../components/ProseLayout.astro';
import Layout from '../../layouts/Layout.astro';
import {
	formatDate,
	getPublishedPosts,
	projectTitle,
	toDateTime,
} from '../../utils/content';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const relatedIds = new Set(project.data.relatedPosts?.map((reference) => reference.id) ?? []);
const relatedPosts = (await getPublishedPosts()).filter((post) => relatedIds.has(post.id));
const title = projectTitle(project);
---

<Layout
	title={title}
	description={project.data.description ?? `${title} の制作記録。`}
	image={project.data.cover?.src}
>
	<article class="max-w-[var(--measure)]">
		<header class="mb-12">
			<ProjectStatus status={project.data.status} />
			<h1 class="mt-1 mb-3 text-[clamp(2rem,6vw,3rem)] leading-[1.15] font-semibold tracking-[-0.035em]">
				{title}
			</h1>
			{project.data.description && <p class="m-0 text-[1.075rem] text-site-muted">{project.data.description}</p>}

			{
				(project.data.startedAt || project.data.updatedAt || project.data.technologies) && (
					<dl class="mt-6 grid grid-cols-1 gap-x-8 gap-y-3 border-y border-site-faint py-5 min-[45rem]:grid-cols-2">
						{project.data.startedAt && (
							<div class="min-w-0">
								<dt class="text-xs font-semibold text-site-muted">開始</dt>
								<dd class="mt-0.5 mb-0">
									<time datetime={toDateTime(project.data.startedAt)}>
										{formatDate(project.data.startedAt)}
									</time>
								</dd>
							</div>
						)}
						{project.data.updatedAt && (
							<div class="min-w-0">
								<dt class="text-xs font-semibold text-site-muted">最終更新</dt>
								<dd class="mt-0.5 mb-0">
									<time datetime={toDateTime(project.data.updatedAt)}>
										{formatDate(project.data.updatedAt)}
									</time>
								</dd>
							</div>
						)}
						{project.data.technologies && project.data.technologies.length > 0 && (
							<div class="min-w-0">
								<dt class="text-xs font-semibold text-site-muted">使用技術</dt>
								<dd class="mt-0.5 mb-0 break-words">{project.data.technologies.join(' / ')}</dd>
							</div>
						)}
					</dl>
				)
			}

			{
				(project.data.repository || project.data.demo) && (
					<div class="mt-4 flex flex-wrap gap-4">
						{project.data.repository && (
							<ExternalLink href={project.data.repository}>リポジトリ</ExternalLink>
						)}
						{project.data.demo && <ExternalLink href={project.data.demo}>デモ</ExternalLink>}
					</div>
				)
			}

			{
				project.data.cover && (
					<img
						class="mt-7 block h-auto w-full border border-site-faint bg-site-surface"
						src={project.data.cover.src}
						alt={project.data.cover.alt}
						width="1200"
						height="675"
						loading="eager"
						fetchpriority="high"
					/>
				)
			}
		</header>

		<ProseLayout>
			<Content />
		</ProseLayout>
	</article>

	{
		relatedPosts.length > 0 && (
			<aside
				class="mt-16 max-w-[var(--measure)] border-t border-site-faint pt-6"
				aria-labelledby="related-posts"
			>
				<h2 class="mt-0 mb-3 text-lg font-semibold" id="related-posts">関連記事</h2>
				<PostList posts={relatedPosts} headingLevel={3} />
			</aside>
		)
	}
</Layout>

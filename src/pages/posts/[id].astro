---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleMetadata from '../../components/ArticleMetadata.astro';
import ContentColumn from '../../components/ContentColumn.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import ProjectList from '../../components/ProjectList.astro';
import ProseLayout from '../../components/ProseLayout.astro';
import TagList from '../../components/TagList.astro';
import Layout from '../../layouts/Layout.astro';
import { getSortedProjects } from '../../utils/content';

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => !import.meta.env.PROD || !data.draft);
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
	post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const projects = (await getSortedProjects()).filter((project) =>
	project.data.relatedPosts?.some((reference) => reference.id === post.id),
);

---

<Layout
	title={post.data.title}
	description={post.data.description}
	article
	publishedAt={post.data.publishedAt}
	updatedAt={post.data.updatedAt}
	tags={post.data.tags}
>
	<ContentColumn>
	<article>
		<header class="mb-12">
			<h1 class="mt-0 mb-3 text-[clamp(2rem,6vw,3rem)] leading-[1.15] font-semibold tracking-[-0.035em]">
				{post.data.title}
			</h1>
			<p class="m-0 text-[1.075rem] text-site-muted">{post.data.description}</p>
			<div class="mt-3.5">
				<ArticleMetadata
					publishedAt={post.data.publishedAt}
					updatedAt={post.data.updatedAt}
					type={post.data.type}
				/>
			</div>
			<div class="mt-3.5"><TagList tags={post.data.tags} /></div>
		</header>
		<ProseLayout>
			<Content />
		</ProseLayout>
	</article>

	{
		projects.length > 0 && (
			<aside
				class="mt-16 border-t border-site-faint pt-6"
				aria-labelledby="related-projects"
			>
				<h2 class="mt-0 mb-3 text-lg font-semibold" id="related-projects">関連する制作物</h2>
				<ProjectList projects={projects} headingLevel={3} />
			</aside>
		)
	}

	<GiscusComments />
	</ContentColumn>
</Layout>

if [[ ! -d "/home/jinji/Projects/floating-gate" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/home/jinji/Projects/floating-gate")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/home/jinji/Projects/floating-gate" true
